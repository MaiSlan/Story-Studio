# Copy this file to ".env" and fill in at least ONE provider. Restart the backend after editing.
# (In the cloud on Modal these same names go into the "story-studio" secret instead of a .env file.)
# Keys are only ever sent to the provider they belong to.

# Google Gemini: free key at https://aistudio.google.com  (free tier: Google may use prompts to improve its products)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Groq (with a Q): free tier, https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b     # the Llama models left the free tier in Aug 2026

# Claude (Anthropic API, pay per use, a few cents per story). Key from https://console.anthropic.com
# This is NOT the same as a claude.ai subscription.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Other OpenAI-compatible services (optional)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
XAI_API_KEY=
# XAI_MODEL=grok-4
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Local models with Ollama (free, no key): https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:14b

# Your own Claude plan through the Claude Code program (only when this runs on YOUR computer, localhost only).
# Install Claude Code, run `claude` once and sign in, then pick "Claude via your Claude app login" in the app.
# CLAUDE_CODE_MODEL=sonnet
# CLAUDE_BIN=claude

# Which AI is preselected in the form (anthropic, gemini, groq, openai, xai, openrouter, ollama, claude_code, mock)
# DEFAULT_PROVIDER=gemini

# ---- Only when the backend runs online (Modal / Render / Docker) ----
# APP_PASSWORD=choose-a-long-password        # REQUIRED online: anyone with the address could spend your AI credit
# ALLOWED_ORIGINS=https://your-project.vercel.app    # the website that may call this API (comma separated, no trailing slash)
# ALLOWED_ORIGIN_REGEX=https://your-project.*\.vercel\.app   # optional: also allow Vercel preview deployments
# STORY_DATA_DIR=/data                       # where stories are kept (a persistent disk / volume)
# HOST=0.0.0.0
# PORT=8000
